# ============================================================
# Legal Mapper — Backend Environment Variables
# Copy to .env and fill in your values before running locally.
# ============================================================

# PostgreSQL connection string
# Local:   postgresql://postgres:postgres@localhost:5432/legalmapper
# Neon:    postgresql://user:password@host.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legalmapper

# JWT secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Free plan: max searches per day (default 10)
FREE_DAILY_SEARCH_LIMIT=10

# CORS — comma-separated list of allowed origins
# e.g. https://legal-mapper.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# OpenAI API key (only required for the /explain endpoint)
OPENAI_API_KEY=

# Razorpay credentials (only required for payment endpoints)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Pro plan price in paise (100 paise = ₹1). Default: ₹499
PRO_PLAN_AMOUNT_PAISE=49900
